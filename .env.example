# ============================================================
# Flask AI 趨勢偵測系統 - 環境變數配置範例
# ============================================================
# 複製此檔案為 .env 並填入實際值

# ============================================================
# 必填配置
# ============================================================

# PostgreSQL 資料庫連接字串
# 格式：postgresql://使用者名稱:密碼@主機:埠/資料庫名稱
DATABASE_URL=postgresql://user:password@localhost:5432/ai_trends

# DeepSeek API 金鑰（從 DeepSeek 官網取得）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================================
# 可選配置（有預設值）
# ============================================================

# Flask 密鑰（用於 session 加密）
SECRET_KEY=your-secret-key-here

# Debug 模式（生產環境請設為 False）
DEBUG=False

# ============================================================
# 資料庫連接池配置
# ============================================================

# 連接池最小連接數（預設: 2）
DB_POOL_MIN=2

# 連接池最大連接數（預設: 10）
DB_POOL_MAX=10

# ============================================================
# 快取配置
# ============================================================

# 關鍵字快取時間（秒，預設: 3600 = 1小時）
KEYWORD_CACHE_TTL=3600

# 文章快取時間（秒，預設: 3600 = 1小時）
ARTICLE_CACHE_TTL=3600

# ============================================================
# 執行緒與速率限制
# ============================================================

# 文章生成工作執行緒數（預設: 3）
# 注意：數量越多越快，但會增加 API 呼叫壓力
ARTICLE_GENERATION_WORKERS=3

# API 呼叫速率限制（calls per second，預設: 0.5 = 每2秒1次）
# 注意：過高可能導致 API 限流
API_RATE_LIMIT=0.5

# ============================================================
# DeepSeek API 配置
# ============================================================

# API 超時時間（秒，預設: 120）
DEEPSEEK_TIMEOUT=120

# 溫度參數（0-1，預設: 0.7）
DEEPSEEK_TEMPERATURE=0.7

# 最大 token 數（預設: 3500）
DEEPSEEK_MAX_TOKENS=3500

# ============================================================
# 爬蟲配置
# ============================================================

# SWD 爬取天數（預設: 30）
SWD_CRAWL_DAYS=30

# HA 爬取天數（預設: 30）
HA_CRAWL_DAYS=30

# HA 最大頁數（預設: 200）
HA_MAX_PAGES=200

# HA 最大項目數（預設: 500）
HA_MAX_ITEMS=500

# HA 爬蟲延遲（秒，預設: 0.8）
HA_SLEEP=0.8

# ============================================================
# 內容限制
# ============================================================

# 中文參考資料最大字元數（預設: 3800）
MAX_CHARS_ZH=3800

# 英文參考資料最大字元數（預設: 4200）
MAX_CHARS_EN=4200

# 預設近期天數（預設: 30）
DEFAULT_RECENT_DAYS=30
