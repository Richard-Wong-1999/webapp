# ============================================================
# Flask AI 趨勢偵測系統 - 環境變數配置範例
# ============================================================
# 複製此檔案為 .env 並填入實際值

# ============================================================
# 必填配置
# ============================================================

# PostgreSQL 資料庫連接字串
# 格式：postgresql://使用者名稱:密碼@主機:埠/資料庫名稱
DATABASE_URL=postgresql://user:password@localhost:5432/ai_trends

# DeepSeek API 金鑰（從 DeepSeek 官網取得）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================================
# 可選配置（有預設值）
# ============================================================

# Flask 密鑰（用於 session 加密）
SECRET_KEY=your-secret-key-here

# Debug 模式（生產環境請設為 False）
DEBUG=False

# ============================================================
# 資料庫連接池配置
# ============================================================

# 連接池最小連接數（預設: 2）
DB_POOL_MIN=2

# 連接池最大連接數（預設: 10）
DB_POOL_MAX=10

# ============================================================
# 快取配置
# ============================================================

# 關鍵字快取時間（秒，預設: 3600 = 1小時）
KEYWORD_CACHE_TTL=3600

# 文章快取時間（秒，預設: 3600 = 1小時）
ARTICLE_CACHE_TTL=3600

# ============================================================
# 執行緒與速率限制
# ============================================================

# 文章生成工作執行緒數（預設: 3）
# 注意：數量越多越快，但會增加 API 呼叫壓力
ARTICLE_GENERATION_WORKERS=3

# API 呼叫速率限制（calls per second，預設: 0.5 = 每2秒1次）
# 注意：過高可能導致 API 限流
API_RATE_LIMIT=0.5

# ============================================================
# DeepSeek API 配置
# ============================================================

# API 超時時間（秒，預設: 120）
DEEPSEEK_TIMEOUT=120

# 溫度參數（0-1，預設: 0.7）
DEEPSEEK_TEMPERATURE=0.7

# 最大 token 數（預設: 3500）
DEEPSEEK_MAX_TOKENS=3500

# ============================================================
# 爬蟲配置
# ============================================================

# SWD 爬取天數（預設: 30）
SWD_CRAWL_DAYS=30

# HA 爬取天數（預設: 30）
HA_CRAWL_DAYS=30

# HA 最大頁數（預設: 200）
HA_MAX_PAGES=200

# HA 最大項目數（預設: 500）
HA_MAX_ITEMS=500

# HA 爬蟲延遲（秒，預設: 0.8）
HA_SLEEP=0.8

# ============================================================
# 內容限制
# ============================================================

# 中文參考資料最大字元數（預設: 3800）
MAX_CHARS_ZH=3800

# 英文參考資料最大字元數（預設: 4200）
MAX_CHARS_EN=4200

# 預設近期天數（預設: 30）
DEFAULT_RECENT_DAYS=30

# ============================================================
# DataForSEO API 配置（SEO 關鍵字研究功能）
# ============================================================
# 從 DataForSEO 官網取得 API 憑證
# 註冊地址：https://dataforseo.com/

DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# DataForSEO API 速率限制（calls per second，預設: 0.5）
DATAFORSEO_RATE_LIMIT=0.5

# ============================================================
# Poe API 配置（多模型支援）
# ============================================================
# 從 Poe 官網取得 API 金鑰
# 註冊地址：https://poe.com/api_key
# 價格參考：https://poe.com/api/models

POE_API_KEY=your_poe_api_key_here

# ============================================================
# Wix Blog API 配置（文章發送至 Wix Blog）
# ============================================================
# 用於將生成的文章以草稿形式發送到 Wix Blog
# 需要在 Wix Developers 創建應用並獲取 OAuth 憑證
# 文檔：https://dev.wix.com/docs/rest/api-reference/wix-blog/blog/draft-posts

# Wix OAuth 應用的 Client ID
WIX_CLIENT_ID=your_wix_client_id_here

# Wix OAuth 應用的 Client Secret
WIX_CLIENT_SECRET=your_wix_client_secret_here

# Wix 網站的 Instance ID（Site ID）
# 可從 Wix Dashboard URL 獲取或透過 API 查詢
WIX_INSTANCE_ID=your_wix_instance_id_here

# Wix OAuth Refresh Token
# 通過 OAuth 流程獲取，用於自動刷新 Access Token
WIX_REFRESH_TOKEN=your_wix_refresh_token_here

# Wix Blog Writer Member ID
# 用於創建草稿文章的作者 ID，可從已發布文章中獲取
# 或在 Wix Blog 設定中添加 Writer 後查詢
WIX_MEMBER_ID=your_wix_member_id_here
